# JARVIS V3.0 Configuration Example
# Copy this file to .env and fill in your keys

# AI Provider ("gemini", "openai", "ollama")
AI_PROVIDER=gemini
DEFAULT_MODEL=gemini-flash-latest

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Voice & Speech
JARVIS_VOICE=en-GB-RyanNeural
WAKE_WORD=jarvis
WHISPER_MODEL=base
USE_LOCAL_STT=true

# Security & Cloud Authentication
AUTH_TOKEN=your_secure_random_token_here

# Hardware / Module Toggles
CLAP_ENABLED=true
GESTURES_ENABLED=true
VISION_ENABLED=true
UI_FRAMEWORK=pyside6
