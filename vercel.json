{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "interface/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/v1/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/health",
      "dest": "api/index.py"
    },
    {
      "src": "/ask",
      "dest": "api/index.py"
    },
    {
      "src": "/interface/(.*)",
      "dest": "/interface/$1"
    },
    {
      "src": "/hologram",
      "dest": "/interface/index.html"
    },
    {
      "src": "/",
      "dest": "/interface/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}